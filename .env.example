# ---------------------------------------------------------------------------
# Hybrid RAG platform configuration. Copy to .env and adjust.
# Nested settings use "__" (e.g. EMBEDDING__MODEL). Pipeline defaults live in
# config/rag.yaml; anything set here overrides that file.
# ---------------------------------------------------------------------------

ENVIRONMENT=local
LOG_LEVEL=INFO

# Enables the bundled Ollama LLM container (remove if you use a hosted LLM).
COMPOSE_PROFILES=local-llm

# --- Security --------------------------------------------------------------
# Required for POST /v1/admin/tenants. CHANGE THIS.
SECURITY__ADMIN_API_KEY=change-me-admin-key

# --- Infrastructure (host-side defaults; docker compose overrides these) ----
# Host ports (15432 avoids clashing with a locally installed PostgreSQL).
API_PORT=8000
POSTGRES_PORT=15432
DATABASE__URL=postgresql+asyncpg://rag:rag@localhost:15432/rag
QDRANT__URL=http://localhost:6333
STORAGE__BLOB_DIR=./data/blobs
FASTEMBED_CACHE_PATH=./.cache/models

# --- Embeddings (default for NEW knowledge bases) ---------------------------
# fastembed = local ONNX models; openai = any OpenAI-compatible /embeddings API;
# hashing = deterministic test embedder (not semantic).
EMBEDDING__PROVIDER=fastembed
EMBEDDING__MODEL=mixedbread-ai/mxbai-embed-large-v1
EMBEDDING__DIMENSION=1024
EMBEDDING__VERSION=v1
EMBEDDING__DISTANCE_METRIC=cosine
# OpenAI example (1536 or 3072 dims):
# EMBEDDING__PROVIDER=openai
# EMBEDDING__MODEL=text-embedding-3-large
# EMBEDDING__DIMENSION=3072
# EMBEDDING__API_KEY=sk-...

# --- Chunking ---------------------------------------------------------------
# Platform default is 800/120 tokens. mxbai-embed-large-v1 reads at most 512
# tokens, so the local stack uses smaller chunks to avoid truncating embeddings.
# Restore 800/120 with long-context embedders (e.g. text-embedding-3-*).
CHUNKING__CHUNK_SIZE=480
CHUNKING__CHUNK_OVERLAP=72

# --- Reranker (cross-encoder) ------------------------------------------------
RERANKER__PROVIDER=fastembed
RERANKER__MODEL=jinaai/jina-reranker-v2-base-multilingual
# Cross-encoder cost grows with candidates x passage length. On CPU, reranking the best 20
# fused candidates matched the quality of all 40 at ~2.5x lower latency (ZTBL eval).
# For faster CPU reranking use RERANKER__MODEL=Xenova/ms-marco-MiniLM-L-12-v2 (~3x faster, slightly lower quality).
RERANKER__MAX_CANDIDATES=20
# Other cross-encoders: RERANKER__MODEL=BAAI/bge-reranker-v2-m3 (multilingual, 8K context; int8 ONNX, ~2x slower than jina on CPU)
# Cohere example:
# RERANKER__PROVIDER=cohere
# RERANKER__MODEL=rerank-v3.5
# RERANKER__API_KEY=...

# --- LLM --------------------------------------------------------------------
# Local Ollama (OpenAI-compatible) - pulled automatically by docker compose.
LLM__PROVIDER=openai_compatible
LLM__MODEL=qwen2.5:3b
LLM__BASE_URL=http://ollama:11434/v1
# (use http://localhost:11434/v1 when running the API directly on the host)
# Groq example (fast hosted open models; key from https://console.groq.com/keys).
# Also remove COMPOSE_PROFILES=local-llm above - Ollama is not needed.
# LLM__PROVIDER=groq
# LLM__MODEL=<a model id from GET https://api.groq.com/openai/v1/models>
# LLM__API_KEY=gsk_...
# Anthropic example:
# LLM__PROVIDER=anthropic
# LLM__MODEL=claude-opus-5-5
# LLM__API_KEY=sk-ant-...
# OpenAI example:
# LLM__PROVIDER=openai_compatible
# LLM__MODEL=gpt-4.1-mini
# LLM__BASE_URL=https://api.openai.com/v1
# LLM__API_KEY=sk-...

# --- Voice (mic -> Silero VAD -> Groq Whisper -> hybrid RAG -> Soniox TTS) ---
# Optional: without keys the text API runs normally and /v1/voice/* returns 503.
# STT reuses LLM__API_KEY when LLM__PROVIDER=groq; set VOICE__STT_API_KEY otherwise.
# VOICE__STT_API_KEY=gsk_...
VOICE__STT_MODEL=whisper-large-v3
# Domain vocabulary for Whisper (names/jargon it would otherwise mishear). Per-session override:
# "stt_prompt" in the WebSocket start message.
# VOICE__STT_PROMPT=Riba, Ijarah, Murabaha, Musharakah, Mudarabah, Shariah
# Force the decode language (default: auto-detect per utterance):
# VOICE__STT_LANGUAGE=en
# soniox | none (text-only answers)
VOICE__TTS_PROVIDER=soniox
# VOICE__TTS_API_KEY=...
VOICE__TTS_VOICE=Nina
# Spoken language when STT does not report one:
VOICE__TTS_LANGUAGE=en
# VAD tuning (Silero): how long a pause ends the turn, and the speech threshold.
# VOICE__VAD__MIN_SILENCE_MS=1000
# VOICE__VAD__THRESHOLD=0.5
# Public assistant for the simple user page (/voice/): key-less voice sessions are answered from
# this knowledge base (its content becomes reachable without an API key). Unset = disabled.
# VOICE__PUBLIC_KNOWLEDGE_BASE_ID=<knowledge base uuid>
# VOICE__PUBLIC_TITLE=Voice assistant
